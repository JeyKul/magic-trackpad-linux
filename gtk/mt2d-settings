#!/usr/bin/env python3
"""Magic Trackpad settings for GNOME and other GTK desktops (libadwaita)."""

import json
import math
import os
import socket
import sys
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402
from OpenGL import GL  # noqa: E402

SOCKET_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "mt2d.sock")

STRENGTHS = [("light", "Light"), ("medium", "Medium"), ("firm", "Firm"),
             ("max", "Maximum (loud)"), ("off", "Off (silent clicks)")]
ACTIONS = [
    (["BTN_MIDDLE"], "Middle click"),
    (["BTN_RIGHT"], "Right click"),
    (["KEY_BACK"], "Back"),
    (["KEY_FORWARD"], "Forward"),
    (["KEY_LEFTMETA"], "Super key"),
    (None, "Custom keys"),
]


class Daemon:
    def __init__(self):
        self.path = os.path.join(os.path.dirname(SOCKET_PATH), f"mt2d-gtk-{os.getpid()}.sock")
        if os.path.exists(self.path):
            os.unlink(self.path)
        self.client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.client.bind(self.path)

    def close(self):
        self.client.close()
        os.unlink(self.path)

    def call(self, cmd):
        # Drop late replies to earlier calls that timed out
        self.client.setblocking(False)
        try:
            while self.client.recv(65536):
                pass
        except BlockingIOError:
            pass
        try:
            # Applying settings may touch slow hardware; polling should fail fast
            self.client.settimeout(1.5 if cmd["op"] == "live" else 5)
            self.client.sendto(json.dumps(cmd).encode(), SOCKET_PATH)
            return json.loads(self.client.recv(65536))
        except OSError as e:
            return {"ok": False, "error": f"mt2d is not running ({e.strerror or e})"}


def find_shader():
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "..", "shaders", "ripple.glsl"),
                 os.path.expanduser("~/.local/share/mt2d/ripple.glsl"),
                 "/usr/share/mt2d/ripple.glsl"):
        if os.path.exists(path):
            with open(path) as f:
                return f.read()
    raise FileNotFoundError("ripple.glsl not found")


VERTEX = """#version 330 core
void main()
{
    // Full-screen triangle, no vertex buffer needed
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
"""

# Pass 1: one texel per dot (waves, fingers)
STATE_FRAGMENT = """#version 330 core
out vec4 fragColor;
uniform vec2 fieldSize;
uniform float time;
uniform vec4 W[8];
uniform vec4 T[5];
vec4 loadState(vec2 c) { return vec4(0.0); }  // unused in this pass
%s
void main()
{
    fragColor = encodeState(dotState(floor(gl_FragCoord.xy)));
}
"""

# Pass 2: per pixel, reads the 3x3 nearest dots from pass 1
FRAGMENT = """#version 330 core
out vec4 fragColor;
uniform vec2 fieldSize;
uniform float scale;
uniform vec4 T[5];
uniform sampler2D states;
float time;  // only used by pass 1
vec4 W[8];
vec2 gridSize(vec2 size);
vec4 loadState(vec2 c)
{
    return texelFetch(states, ivec2(clamp(c, vec2(0.0), gridSize(fieldSize) - 1.0)), 0);
}
%s
void main()
{
    vec2 px = vec2(gl_FragCoord.x, fieldSize.y * scale - gl_FragCoord.y) / scale;
    fragColor = shade(px);
}
"""

SPACING = 6  # must match ripple.glsl


def compile_programs(core):
    from OpenGL.GL import shaders
    vertex = shaders.compileShader(VERTEX, GL.GL_VERTEX_SHADER)
    return [shaders.compileProgram(vertex, shaders.compileShader(src % core, GL.GL_FRAGMENT_SHADER),
                                   validate=False)
            for src in (STATE_FRAGMENT, FRAGMENT)]


class FieldRenderer:
    """GL side of the field; needs a current GL 3.3 context. Kept apart from
    the widget so it can also be benchmarked headless."""

    def __init__(self):
        self.state_program, self.program = compile_programs(find_shader())
        self.vao = GL.glGenVertexArrays(1)
        self.fbo = GL.glGenFramebuffers(1)
        self.texture = GL.glGenTextures(1)
        self.grid = None
        self.loc = {p: {name: GL.glGetUniformLocation(p, name)
                        for name in ("fieldSize", "time", "scale", "W", "T", "states")}
                    for p in (self.state_program, self.program)}

    def delete(self):
        GL.glDeleteTextures(1, [self.texture])
        GL.glDeleteFramebuffers(1, [self.fbo])
        GL.glDeleteVertexArrays(1, [self.vao])
        GL.glDeleteProgram(self.state_program)
        GL.glDeleteProgram(self.program)

    def ensure_grid(self, w, h):
        grid = (math.ceil(w / SPACING) + 1, math.ceil(h / SPACING) + 1)
        if grid == self.grid:
            return
        self.grid = grid
        GL.glBindTexture(GL.GL_TEXTURE_2D, self.texture)
        GL.glTexImage2D(GL.GL_TEXTURE_2D, 0, GL.GL_RGBA8, *grid, 0, GL.GL_RGBA, GL.GL_UNSIGNED_BYTE, None)
        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_MIN_FILTER, GL.GL_NEAREST)
        GL.glTexParameteri(GL.GL_TEXTURE_2D, GL.GL_TEXTURE_MAG_FILTER, GL.GL_NEAREST)
        GL.glBindFramebuffer(GL.GL_FRAMEBUFFER, self.fbo)
        GL.glFramebufferTexture2D(GL.GL_FRAMEBUFFER, GL.GL_COLOR_ATTACHMENT0, GL.GL_TEXTURE_2D, self.texture, 0)

    def render(self, w, h, scale, now, waves, touches, bind_target):
        """Draws a w x h (logical) field; bind_target() rebinds the output framebuffer."""
        flat_t = [(t["x"] * w, t["y"] * h, t["p"] / 253, 1.0) for t in touches[:5]]
        flat_t = [c for t in flat_t + [(0.0, 0.0, 0.0, 0.0)] * (5 - len(flat_t)) for c in t]
        GL.glBindVertexArray(self.vao)

        self.ensure_grid(w, h)
        GL.glBindFramebuffer(GL.GL_FRAMEBUFFER, self.fbo)
        GL.glViewport(0, 0, *self.grid)
        GL.glDisable(GL.GL_BLEND)
        loc = self.loc[self.state_program]
        GL.glUseProgram(self.state_program)
        GL.glUniform2f(loc["fieldSize"], w, h)
        GL.glUniform1f(loc["time"], now)
        GL.glUniform4fv(loc["W"], 8, [c for wave in waves for c in wave])
        GL.glUniform4fv(loc["T"], 5, flat_t)
        GL.glDrawArrays(GL.GL_TRIANGLES, 0, 3)

        bind_target()
        GL.glViewport(0, 0, int(w * scale), int(h * scale))
        GL.glClearColor(0, 0, 0, 0)
        GL.glClear(GL.GL_COLOR_BUFFER_BIT)
        loc = self.loc[self.program]
        GL.glUseProgram(self.program)
        GL.glUniform2f(loc["fieldSize"], w, h)
        GL.glUniform1f(loc["scale"], scale)
        GL.glUniform4fv(loc["T"], 5, flat_t)
        GL.glActiveTexture(GL.GL_TEXTURE0)
        GL.glBindTexture(GL.GL_TEXTURE_2D, self.texture)
        GL.glUniform1i(loc["states"], 0)
        GL.glDrawArrays(GL.GL_TRIANGLES, 0, 3)


class TrackpadField(Gtk.GLArea):
    """Live view of the trackpad, rendered by shaders/ripple.glsl: a dense dot
    texture, fingers light the dots under them, a click sends a small ripple
    through it, a force click a big one."""

    def __init__(self):
        super().__init__(hexpand=True)
        self.set_allowed_apis(Gdk.GLAPI.GL)
        self.set_required_version(3, 3)
        self.epoch = time.monotonic()
        self.touches = []
        self.waves = [(0.0, 0.0, 0.0, 0.0)] * 8
        self.next_wave = 0
        self.wave_end = 0.0
        self.ticking = False
        self.renderer = None
        self.connect("realize", self.on_realize)
        self.connect("unrealize", self.on_unrealize)
        self.connect("render", self.on_render)
        self.connect("resize", lambda _w, width, _h: self.set_size_request(-1, int(width / self.get_scale_factor() * 115 / 160)))
        self.set_size_request(-1, 300)

    def now(self):
        return time.monotonic() - self.epoch

    def on_realize(self, _area):
        self.make_current()
        if self.get_error():
            return
        try:
            self.renderer = FieldRenderer()
        except Exception as e:  # show the reason instead of a black box
            print(f"trackpad field disabled: {e}", file=sys.stderr)

    def on_unrealize(self, _area):
        self.make_current()
        if self.renderer:
            self.renderer.delete()
            self.renderer = None

    def on_render(self, _area, _context):
        if not self.renderer:
            GL.glClearColor(0, 0, 0, 0)
            GL.glClear(GL.GL_COLOR_BUFFER_BIT)
            return True
        self.renderer.render(self.get_width(), self.get_height(), self.get_scale_factor(),
                             self.now(), self.waves, self.touches, self.attach_buffers)
        return True

    def set_touches(self, touches):
        if touches or self.touches:
            self.touches = touches
            self.queue_render()

    def ripple(self, force):
        t = self.touches[0] if self.touches else {"x": 0.5, "y": 0.5}
        start = self.now()
        self.waves[self.next_wave] = (t["x"] * self.get_width(), t["y"] * self.get_height(),
                                      start, 2.0 if force else 1.0)
        self.next_wave = (self.next_wave + 1) % 8
        self.wave_end = max(self.wave_end, start + (2.4 if force else 1.3))
        if not self.ticking:
            self.ticking = True
            self.add_tick_callback(self.tick)

    def tick(self, *_):
        self.queue_render()
        if self.now() > self.wave_end:
            self.ticking = False
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Magic Trackpad", default_width=560,
                         default_height=760)
        self.daemon = Daemon()
        self.loading = True
        self.pending = {}
        self.dragging = False
        self.save_source = None

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        view.set_content(page)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        # Device
        dev = Adw.PreferencesGroup(title="Device")
        page.add(dev)
        self.device_row = Adw.ActionRow(title="Magic Trackpad", subtitle="Connecting…")
        self.battery_label = Gtk.Label(css_classes=["dim-label"])
        self.device_row.add_suffix(self.battery_label)
        dev.add(self.device_row)

        # Clicking
        clicking = Adw.PreferencesGroup(
            title="Clicking", description="Pressure clicking lets mt2d decide clicks from "
            "the real force curve. Firmware clicking leaves it to the trackpad.")
        page.add(clicking)
        self.mode = Adw.ComboRow(title="Click mode",
                                 model=Gtk.StringList.new(["Pressure",
                                                           "Firmware"]))
        self.mode.connect("notify::selected", self.on_mode)
        clicking.add(self.mode)
        self.click_force = self.scale_row(clicking, "Click force",
                                          "Pressure needed to click", 40, 200, 5,
                                          lambda v: {"click": {"threshold": v,
                                                               "release": max(20, v - 30)}})
        self.strength = Adw.ComboRow(title="Haptic feedback",
                                     model=Gtk.StringList.new([n for _, n in STRENGTHS]))
        self.strength.connect("notify::selected", lambda *_: self.queue(
            {"haptics": {"strength": STRENGTHS[self.strength.get_selected()][0], "silent": False}}))
        clicking.add(self.strength)
        test = Adw.ActionRow(title="Test haptics")
        for value, label in (("weak", "Weak"), ("medium", "Medium"), ("strong", "Strong")):
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            b.connect("clicked", lambda _b, v=value: self.call({"op": "pulse", "value": v}))
            test.add_suffix(b)
        clicking.add(test)

        # Force click
        self.force_group = Adw.PreferencesGroup(
            title="Force click", description="Press harder after clicking to trigger an action.")
        page.add(self.force_group)
        self.force_on = Adw.SwitchRow(title="Force click")
        self.force_on.connect("notify::active", lambda *_: self.queue(
            {"force_click": {"enabled": self.force_on.get_active()}}))
        self.force_group.add(self.force_on)
        self.force_force = self.scale_row(self.force_group, "Force click pressure", None,
                                          150, 253, 1,
                                          lambda v: {"force_click": {"threshold": v,
                                                                     "release": max(100, v - 50)}})
        self.action = Adw.ComboRow(title="Action",
                                   model=Gtk.StringList.new([n for _, n in ACTIONS]))
        self.action.connect("notify::selected", self.on_action)
        self.force_group.add(self.action)
        self.custom = Adw.EntryRow(title="Custom keys (evdev names, e.g. KEY_LEFTMETA KEY_W)",
                                   show_apply_button=True, visible=False)
        self.custom.connect("apply", self.on_custom)
        self.force_group.add(self.custom)
        self.replace = Adw.SwitchRow(title="Replace the normal click",
                                     subtitle="Force click does not also left-click")
        self.replace.connect("notify::active", lambda *_: self.queue(
            {"force_click": {"replace_click": self.replace.get_active()}}))
        self.force_group.add(self.replace)
        self.dwell = Adw.SpinRow.new_with_range(0, 500, 10)
        self.dwell.set_title("Hold time (ms)")
        self.dwell.connect("notify::value", lambda *_: self.queue(
            {"force_click": {"dwell_ms": int(self.dwell.get_value())}}))
        self.force_group.add(self.dwell)

        # Live pressure
        live = Adw.PreferencesGroup(title="Pressure",
                                    description="Touch, click and force click to see what the trackpad reads.")
        page.add(live)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        self.field = TrackpadField()
        box.append(self.field)
        self.meter = Gtk.LevelBar(min_value=0, max_value=253, mode=Gtk.LevelBarMode.CONTINUOUS)
        self.meter.set_size_request(-1, 18)
        self.meter_label = Gtk.Label(xalign=0, css_classes=["dim-label", "numeric"])
        box.append(self.meter)
        box.append(self.meter_label)
        frame = Gtk.Frame(child=box)
        live.add(frame)

        self.load()
        self.loading = False
        self.counters = None
        GLib.timeout_add(16, self.poll)
        self.connect("close-request", lambda *_: self.daemon.close())

    def scale_row(self, group, title, subtitle, lo, hi, step, make):
        row = Adw.ActionRow(title=title, subtitle=subtitle or "")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        scale.set_hexpand(True)
        scale.set_size_request(220, -1)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.LEFT)
        scale.connect("value-changed", lambda s: self.queue(make(int(s.get_value()))))
        # Apply once the slider is let go, not on every step while dragging
        legacy = Gtk.EventControllerLegacy(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        legacy.connect("event", self.on_scale_event)
        scale.add_controller(legacy)
        row.add_suffix(scale)
        group.add(row)
        return scale

    def call(self, cmd):
        r = self.daemon.call(cmd)
        if not r.get("ok") and cmd["op"] != "live":
            self.toasts.add_toast(Adw.Toast(title=r.get("error", "error")))
        return r

    def load(self):
        r = self.call({"op": "get"})
        if not r.get("ok"):
            self.device_row.set_subtitle(r.get("error"))
            return
        c = r["config"]
        self.cfg = c
        self.mode.set_selected(0 if c["mode"] == "host" else 1)
        self.click_force.set_value(c["click"]["threshold"])
        self.strength.set_selected([k for k, _ in STRENGTHS].index(c["haptics"]["strength"]))
        f = c["force_click"]
        self.force_on.set_active(f["enabled"])
        self.force_force.set_value(f["threshold"])
        self.replace.set_active(f["replace_click"])
        self.dwell.set_value(f["dwell_ms"])
        idx = next((i for i, (keys, _) in enumerate(ACTIONS) if keys == f["action"]),
                   len(ACTIONS) - 1)
        self.action.set_selected(idx)
        self.custom.set_text(" ".join(f["action"]))
        self.custom.set_visible(ACTIONS[idx][0] is None)
        self.update_mode_sensitivity()

    def update_mode_sensitivity(self):
        host = self.mode.get_selected() == 0
        self.force_group.set_sensitive(host)
        self.click_force.get_parent().set_sensitive(host)

    def on_mode(self, *_):
        self.update_mode_sensitivity()
        self.queue({"mode": "host" if self.mode.get_selected() == 0 else "firmware"})

    def on_action(self, *_):
        keys = ACTIONS[self.action.get_selected()][0]
        self.custom.set_visible(keys is None)
        if keys:
            self.queue({"force_click": {"action": keys}})

    def on_custom(self, entry):
        keys = entry.get_text().split()
        if keys:
            self.queue({"force_click": {"action": keys}})

    def on_scale_event(self, _controller, event):
        kind = event.get_event_type()
        if kind in (Gdk.EventType.BUTTON_PRESS, Gdk.EventType.TOUCH_BEGIN):
            self.dragging = True
        elif kind in (Gdk.EventType.BUTTON_RELEASE, Gdk.EventType.TOUCH_END, Gdk.EventType.TOUCH_CANCEL):
            self.dragging = False
            if self.pending:
                self.schedule_flush(0)
        return False  # let the slider handle the event too

    def schedule_flush(self, delay):
        if self.save_source:
            GLib.source_remove(self.save_source)
        self.save_source = GLib.timeout_add(delay, self.flush)

    def queue(self, change):
        if self.loading:
            return
        for section, value in change.items():
            if isinstance(value, dict):
                self.pending.setdefault(section, {}).update(value)
            else:
                self.pending[section] = value
        if not self.dragging:
            self.schedule_flush(250)

    def flush(self):
        self.save_source = None
        change, self.pending = self.pending, {}
        r = self.call({"op": "set", "config": change})
        if r.get("ok"):
            self.cfg = r["config"]
        return False

    def poll(self):
        r = self.daemon.call({"op": "live"})
        if not r.get("ok"):
            self.device_row.set_subtitle(r.get("error"))
            self.battery_label.set_text("")
            return True
        self.device_row.set_subtitle("Connected" if r["connected"] else "Not connected")
        self.battery_label.set_text(f"Battery {r['battery']}%" if r["battery"] is not None else "")
        p = r["pressure"]
        self.meter.set_value(p)
        self.field.set_touches(r.get("touches", []))
        counters = (r.get("clicks", 0), r.get("forces", 0))
        if self.counters:
            if counters[1] > self.counters[1]:
                self.field.ripple(True)
            elif counters[0] > self.counters[0]:
                self.field.ripple(False)
        self.counters = counters
        cfg = getattr(self, "cfg", None)
        if cfg:
            state = "clicked" if r["clicked"] else ""
            if cfg["mode"] == "host" and cfg["force_click"]["enabled"] \
                    and p >= cfg["force_click"]["threshold"]:
                state = "force"
            self.meter_label.set_text(
                f"{p:3d}   click at {cfg['click']['threshold']}, "
                f"force at {cfg['force_click']['threshold']}   {state}")
        return True


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.github.mt2d.Settings")

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
