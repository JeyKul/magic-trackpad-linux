#version 440
// Pass 2: per pixel, see shaders/ripple.glsl (spliced in at build time)

layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;

layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 fieldSize;
    vec4 t0; vec4 t1; vec4 t2; vec4 t3; vec4 t4;
};
layout(binding = 1) uniform sampler2D states;

float time;   // only used by pass 1
vec4 W[8];
vec4 T[5];

vec2 gridSize(vec2 size);

vec4 loadState(vec2 c)
{
    vec2 grid = gridSize(fieldSize);
    return texture(states, (clamp(c, vec2(0.0), grid - 1.0) + 0.5) / grid);
}

@RIPPLE_CORE@

void main()
{
    T = vec4[5](t0, t1, t2, t3, t4);
    fragColor = shade(qt_TexCoord0 * fieldSize) * qt_Opacity;
}
